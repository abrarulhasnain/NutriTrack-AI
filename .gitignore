# ============================================
# NutriTrack - .gitignore
# ============================================

# -----------------------
# OS Files
# -----------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------
# Logs
# -----------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------
# Environment Variables
# -----------------------
.env
.env.*
!.env.example

# -----------------------
# Python
# -----------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Build
build/
dist/
*.egg-info/
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# -----------------------
# Node.js
# -----------------------
node_modules/
npm-cache/

# Build Output
dist/
build/

# Vite
.vite/

# Next.js
.next/

# Nuxt
.nuxt/

# Parcel
.cache/

# -----------------------
# Electron
# -----------------------
release/
out/

# -----------------------
# React
# -----------------------
coverage/

# -----------------------
# Database
# -----------------------
*.sqlite
*.sqlite3

# PostgreSQL Local Data
postgres-data/

# -----------------------
# IDEs
# -----------------------
.vscode/
.idea/

# VSCode Settings (Optional)
!.vscode/extensions.json
!.vscode/settings.json

# -----------------------
# Temporary Files
# -----------------------
*.tmp
*.temp
*.bak
*.swp

# -----------------------
# Docker
# -----------------------
docker-compose.override.yml

# -----------------------
# Mac/Linux
# -----------------------
.AppleDouble
.LSOverride

# -----------------------
# Windows
# -----------------------
ehthumbs.db

# -----------------------
# Secrets
# -----------------------
*.pem
*.key
*.crt

# API Keys
secrets/
credentials.json

# -----------------------
# Generated Files
# -----------------------
*.pdf
*.zip

# Except documentation PDFs
!docs/**/*.pdf
docs/NutriTrack/docs/01_Project_Charter.md
docs/NutriTrack/docs/01_Project_Charter.md
docs/NutriTrack/docs/02_SRS.md
docs/NutriTrack/docs/03_SDD.md
docs/NutriTrack/docs/04_Database_Design.md
docs/NutriTrack/docs/05_API_Design.md
docs/NutriTrack/docs/06_UI_UX.md
docs/NutriTrack/docs/07_Testing.md
docs/NutriTrack/docs/08_Deployment.md
docs/NutriTrack/docs/09_Roadmap.md
